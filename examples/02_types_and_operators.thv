# ------------------------------------------------------------------------------
# Thava Example 02: Types, Arithmetic & Compound Assignments
# ------------------------------------------------------------------------------

func test_arithmetic() {
    <int> a = 15
    <int> b = 4

    <int> sum = a + b
    <int> diff = a - b
    <int> prod = a * b
    <int> quot = a / b
    <int> rem = a % b

    cons.out("Integer Operations:")
    cons.out("  @{a} + @{b} = @{sum}")
    cons.out("  @{a} - @{b} = @{diff}")
    cons.out("  @{a} * @{b} = @{prod}")
    cons.out("  @{a} / @{b} = @{quot}")
    cons.out("  @{a} % @{b} = @{rem}")

    cons.out("Floating Point Operations:")
    <dbl> x = 10.5
    x += 2.5
    cons.out("  x after += 2.5 is @{x}")
    x *= 2.0
    cons.out("  x after *= 2.0 is @{x}")

    # Conditional expression (Python-style ternary)
    <bl> is_fast = true
    <str> status = "Fast" if is_fast else "Slow"
    cons.out("  Execution mode: @{status}")
}

test_arithmetic()
