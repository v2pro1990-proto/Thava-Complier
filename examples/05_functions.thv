# ------------------------------------------------------------------------------
# Thava Example 05: Functions & Recursion
# ------------------------------------------------------------------------------

<int> func factorial(<int> n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

<int> func fibonacci(<int> n) {
    if n <= 0 {
        return 0
    } elif n == 1 {
        return 1
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

<dbl> func calculate_hypotenuse(<dbl> a, <dbl> b) {
    # Using arithmetic operations
    <dbl> sq = a * a + b * b
    return sq
}

func main() {
    cons.out("Factorial of 5: @{factorial(5)}")
    cons.out("Factorial of 7: @{factorial(7)}")

    cons.out("Fibonacci sequence (first 8 numbers):")
    for <int> i in range(8) {
        cons.out("  fib(@{i}) = @{fibonacci(i)}")
    }

    <dbl> hyp_squared = calculate_hypotenuse(3.0, 4.0)
    cons.out("Hypotenuse squared for 3.0 and 4.0: @{hyp_squared}")
}

main()
