<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{$guid1$}</ProjectGuid>
    <RootNamespace>$safeprojectname$</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\Thava.props" Condition="Exists('$(VCTargetsPath)\BuildCustomizations\Thava.props')" />
    <Import Project="$(THAVA_SDK_DIR)\MSBuild\Thava.props" Condition="!Exists('$(VCTargetsPath)\BuildCustomizations\Thava.props') and '$(THAVA_SDK_DIR)' != '' and Exists('$(THAVA_SDK_DIR)\MSBuild\Thava.props')" />
    <Import Project="$(LocalAppData)\Programs\ThavaSDK\MSBuild\Thava.props" Condition="!Exists('$(VCTargetsPath)\BuildCustomizations\Thava.props') and ('$(THAVA_SDK_DIR)' == '' or !Exists('$(THAVA_SDK_DIR)\MSBuild\Thava.props')) and Exists('$(LocalAppData)\Programs\ThavaSDK\MSBuild\Thava.props')" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>$projectname$</TargetName>
    <TargetExt>.thdl</TargetExt>
  </PropertyGroup>
  <ItemGroup>
    <ThavaCompile Include="library.thv">
      <OutputBuildType>DynamicLibrary</OutputBuildType>
    </ThavaCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\Thava.targets" Condition="Exists('$(VCTargetsPath)\BuildCustomizations\Thava.targets')" />
    <Import Project="$(THAVA_SDK_DIR)\MSBuild\Thava.targets" Condition="!Exists('$(VCTargetsPath)\BuildCustomizations\Thava.targets') and '$(THAVA_SDK_DIR)' != '' and Exists('$(THAVA_SDK_DIR)\MSBuild\Thava.targets')" />
    <Import Project="$(LocalAppData)\Programs\ThavaSDK\MSBuild\Thava.targets" Condition="!Exists('$(VCTargetsPath)\BuildCustomizations\Thava.targets') and ('$(THAVA_SDK_DIR)' == '' or !Exists('$(THAVA_SDK_DIR)\MSBuild\Thava.targets')) and Exists('$(LocalAppData)\Programs\ThavaSDK\MSBuild\Thava.targets')" />
  </ImportGroup>
</Project>
