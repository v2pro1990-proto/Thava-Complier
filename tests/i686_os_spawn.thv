<str> platform = os.name()
<str> name = "THAVA_I686_SPAWN"
<bl> set = os.setenv(name, "ready")
<int> status = -1
if platform == "windows" {
    status = os.system("if x%THAVA_I686_SPAWN%==xready (exit /b 0) else (exit /b 3)")
} else {
    status = os.system("test x$THAVA_I686_SPAWN = xready")
}
<bl> clear = os.setenv(name, "")
<str> absent = os.getenv(name)
<str> clock = time.now("YYYY/MM/DD HH:MM:SS %M")
<bl> minuteMatches = clock.getsubstring(15, 16) == clock.getsubstring(21, 22)
cons.out("@{set} @{status} @{clear} [@{absent}] @{minuteMatches}")
