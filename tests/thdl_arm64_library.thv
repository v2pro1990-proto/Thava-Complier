<int> running = 40
func seed() {
    global <int> running
    running += 1
}
seed()

<int> func bump() {
    global <int> running
    running += 1
    return running
}

<dbl> func twice(<dbl> value) {
    return value * 2.0
}

<str> func label() {
    return "thdl"
}

<int> func sum_nine(<int> a, <int> b, <int> c, <int> d, <int> e, <int> f, <int> g, <int> h, <int> i) {
    return a + b + c + d + e + f + g + h + i
}

<dbl> func update_nine(<int> a, <int> b, <int> c, <int> d, <int> e, <int> f, <int> g, <int> h, <lst> items, <dbl> amount) {
    items.addval(a + h)
    return amount * 2.0
}
