<dbl> cfunc sqrt(<dbl> value)
<int64> cfunc _atoi64(<str> value)
<str> path = "./arm64-ci-fixture.dll"
<int64> lib = clib.load(path)
<bl> found = clib.has(lib, "mix")
<bl> absent = clib.has(lib, "missing")
<fl> fraction = 0.5
<dbl> mixed = clib.call_dbl(lib, "mix", 4, 1.25, 3, fraction)
<int64> sum = clib.call(lib, "ninth", 1, 2, 3, 4, 5, 6, 7, 8, 9)
<str> title = clib.call_str(path, "label")
clib.free(lib)
<int64> memory = clib.alloc(16)
clib.poke32(memory, 0, -12)
clib.poke_f(memory, 8, 2.5)
<int> signedWord = clib.peek32(memory, 0)
<dbl> real = clib.peek_f(memory, 8)
clib.free_mem(memory)
<dbl> root = c.sqrt(81.0)
<int64> wide = c._atoi64("5000000000")
<int64> address = clib.call(path, "address")
<int64> pointed = clib.peek64(address)
cons.out("@{found} @{absent} @{mixed} @{sum} @{title} @{signedWord} @{real} @{root} @{wide} @{pointed}")
