<int> func finish_early() {
    file.open("i686-scope.txt", "w") as out_file {
        out_file.write_line("return")
        return 42
    }
    return 0
}

<int> answer = finish_early()
for <int> index in range(0, 3, 1) {
    file.open("i686-scope.txt", "a") as out_file {
        if index == 0 {
            out_file.write_line("continue")
            continue
        }
        out_file.write_line("break")
        break
    }
}
file.open("i686-scope.txt", "r") as in_file {
    <lst> result_lines = in_file.read_lines()
    <str> text = "|".join(result_lines)
    cons.out("@{answer} @{text}")
}
