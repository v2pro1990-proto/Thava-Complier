<int> func ninth(<int> a, <int> b, <int> c, <int> d, <int> e, <int> f, <int> g, <int> h, <int> i) {
    return a + i
}

class Positional {
    <int> func eighth(<int> a, <int> b, <int> c, <int> d, <int> e, <int> f, <int> g, <int> h) {
        return a + h
    }
}

<Positional> obj = Positional()
<int> direct = ninth(10, 2, 3, 4, 5, 6, 7, 8, 9)
<func> callback = ninth
<int> indirect = callback(20, 2, 3, 4, 5, 6, 7, 8, 9)
<int> method = obj.eighth(30, 2, 3, 4, 5, 6, 7, 8)
cons.out("@{direct} @{indirect} @{method}")
